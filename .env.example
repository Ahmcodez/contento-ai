# Copy this file to .env and fill in real values.
# NEVER commit .env or real secrets.

# --- App ---
NODE_ENV=development
PORT=4000

# --- Database ---
DATABASE_URL=postgresql://neondb_owner:****************@ep-polished-mode-zay4xrek-pooler.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Queue / Redis ---
REDIS_URL=

# --- Storage (local dev vs cloud) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# S3-compatible (optional, for later)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI Provider ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Reserved for future providers (do not remove; keeps AIProvider abstraction env-ready)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Limits / Quotas (configurable, never unlimited) ---
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=3600
MAX_CLIPS_PER_VIDEO=10
MAX_AI_REQUESTS_PER_USER_PER_DAY=50
MAX_PROCESSING_JOBS_PER_USER_CONCURRENT=2
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- FFmpeg ---
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
