# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
# Express `trust proxy` setting. Leave as false for local/Docker dev (no
# reverse proxy in front of the app). In production, behind a load
# balancer, set this to the number of proxy hops in front of the app
# (usually 1) or per-IP rate limiting (auth endpoints etc.) will be
# ineffective — see the doc comment in src/config/index.js.
TRUST_PROXY=false

DATABASE_URL=postgres://contento:contento@localhost:5432/contento_dev
REDIS_URL=redis://localhost:6379

# Generate real random strings for these — do not use these examples.
JWT_ACCESS_SECRET=change-me-to-a-random-32-plus-character-string
JWT_REFRESH_SECRET=change-me-to-a-different-random-32-plus-character-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

AI_PROVIDER=none
GEMINI_API_KEY=

TRANSCRIPTION_PROVIDER=none

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_TMP_PATH=./storage/tmp

# Only required if STORAGE_DRIVER=s3. Works with AWS S3 or any
# S3-compatible provider (Backblaze B2, Cloudflare R2, MinIO) — set
# S3_ENDPOINT for anything other than real AWS S3.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=3600
MAX_CLIPS_PER_VIDEO=10
MAX_AI_REQUESTS_PER_USER_PER_DAY=50
MAX_PROCESSING_JOBS_PER_USER_CONCURRENT=2
MAX_PROJECTS_PER_USER=50
MAX_PROCESSING_MINUTES_PER_USER_PER_MONTH=300

MAX_TRANSCRIPT_CHARS_PER_AI_CALL=12000
MAX_TRANSCRIPT_CHUNKS=8
MAX_AI_CALLS_PER_JOB=20
MAX_GENERATED_CONTENT_TYPES=5
AI_RETRY_ATTEMPTS=3

CLIP_MIN_DURATION_SECONDS=15
CLIP_MAX_DURATION_SECONDS=90

CAPTION_FONT=Arial
CAPTION_FONT_SIZE=48
CAPTION_MAX_CHARS_PER_LINE=28
CAPTION_MAX_LINES=2
CAPTION_SAFE_MARGIN_PERCENT=0.08

FFMPEG_OUTPUT_MAX_SIZE_MB=200

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

QUEUE_CONCURRENCY_DEFAULT=2
QUEUE_CONCURRENCY_TRANSCRIPTION=1
