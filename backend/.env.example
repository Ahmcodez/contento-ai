# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://contento:contento@localhost:5432/contento_dev
REDIS_URL=redis://localhost:6379

# Generate real random strings for these — do not use these examples.
JWT_ACCESS_SECRET=change-me-to-a-random-32-plus-character-string
JWT_REFRESH_SECRET=change-me-to-a-different-random-32-plus-character-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

AI_PROVIDER=none
GEMINI_API_KEY=

TRANSCRIPTION_PROVIDER=none

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_TMP_PATH=./storage/tmp

MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=3600
MAX_CLIPS_PER_VIDEO=10
MAX_AI_REQUESTS_PER_USER_PER_DAY=50
MAX_PROCESSING_JOBS_PER_USER_CONCURRENT=2

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

QUEUE_CONCURRENCY_DEFAULT=2
QUEUE_CONCURRENCY_TRANSCRIPTION=1
