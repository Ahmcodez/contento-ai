# Copy to .env.local for local development.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Real production domain, no trailing slash — used for canonical URLs,
# Open Graph/Twitter card image URLs, and the generated sitemap. Using
# https://contento.example (an IANA reserved placeholder domain) until
# the real domain is set here.
NEXT_PUBLIC_SITE_URL=https://contento.example
